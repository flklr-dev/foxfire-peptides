# Copy this file to .env and adjust if needed.
# cp .env.example .env   (macOS/Linux)
# Copy-Item .env.example .env   (PowerShell)

# Local site URL (must match WP_PORT)
WP_PORT=8080
WP_URL=http://localhost:8080

# Database
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=rootpassword

# WordPress admin (used by setup script on first run)
WP_TITLE=Foxfire Peptides
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=changeme
WP_ADMIN_EMAIL=dev@foxfire-peptides.local

# Debug (1 = on, 0 = off)
WORDPRESS_DEBUG=1
